{
  "name": "repos-automation",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "main": "dist/functions/index.js",
  "scripts": {
    "build": "tsc",
    "postinstall": "node scripts/printSHA.js",
    "bundle": "esbuild --bundle --platform=node --format=cjs --target=node24 --external:@azure/functions-core --outfile=dist/functions/index.js src/functions/index.ts",
    "watch": "tsc -w",
    "prestart": "npm run build",
    "start": "func start",
    "test": "vitest run"
  },
  "dependencies": {
    "@azure/functions": "^4.16.2",
    "@azure/identity": "^4.13.2",
    "@azure/keyvault-keys": "^4.10.2",
    "@octokit/rest": "^22.0.1",
    "@octokit/webhooks-methods": "^6.0.0"
  },
  "devDependencies": {
    "@octokit/webhooks-types": "^7.6.1",
    "@tsconfig/node24": "^24.0.4",
    "@tsconfig/strictest": "^2.0.8",
    "@types/node": "^24.13.3",
    "esbuild": "^0.28.2",
    "knip": "^6.32.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "packageManager": "npm@12.0.2+sha512.b885e890b9418fa1693544d05f53e64f9a73ec194837d4258b15fecdd692347b1dd2a517b1b0cbaf9d31cd8e92c3b70956bd2ecc72833a57b4b3098f5bfa7943",
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
